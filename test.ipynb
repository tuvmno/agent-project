   "source": [
    "from difflib import SequenceMatcher\n",
    "def get_similarity(a, b):\n",
    "\t# 두 문장의 유사도 비율을 계산 (0.0 ~ 1.0)\n",
    "\treturn SequenceMatcher(None, a, b).ratio()\n",
    "\n",
    "\n",
    "\n",
    "get_similarity(\n",
    "    \"글로벌 주식형 펀드 자금 동향 – 지역별\",\n",
    "    \"글로벌 주식형 펀드 자금 동향 – 섹터별\")"
   ]
  }
